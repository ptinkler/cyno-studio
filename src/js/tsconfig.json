{
  // The TypeScript half of the migration: every .ts file, fully strict. It grows as files move over from
  // tsconfig.legacy.json; when that one is empty it is deleted and this is the only config.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Un-migrated JS that a .ts file imports is read for its shape but not checked here
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts"]
}
