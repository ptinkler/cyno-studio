{
  // JS type-checked with TypeScript (checkJs). Composables and utils only for now: the .vue components need
  // PropType annotations first (about 250 errors under vue-tsc).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["src/composables/**/*.js", "src/utils/**/*.js"]
}
