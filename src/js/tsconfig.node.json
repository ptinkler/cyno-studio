{
  // The tooling configs (Vite, ESLint) run in Node, not the browser, so they get Node's types and the app's
  // tsconfig.json doesn't (browser code must not see `process` and friends). Same strictness otherwise.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node"], "lib": ["ES2023"] },
  "include": ["vite.config.ts", "eslint.config.ts", "playwright.config.ts"]
}
